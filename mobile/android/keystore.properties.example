# Release signing. Copy to keystore.properties (git-ignored), or point the
# HRMIS_KEYSTORE_PROPERTIES environment variable at a file kept OUTSIDE the repo.
# Keep the keystore and its passwords backed up: phones only accept updates
# signed with the same key.
storeFile=C:/path/outside/the/repo/pcg-hrmis-release.jks
storePassword=
keyAlias=pcg-hrmis
keyPassword=
