<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: Philippine flag blue meeting flag red on a diagonal
     (as on the PCG HRMIS banners), with a soft golden sun glow behind the seal. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/flag_blue"
        android:pathData="M0,0 H108 V108 H0 Z" />
    <path
        android:fillColor="@color/flag_red"
        android:pathData="M68,0 H108 V108 H36 Z" />
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="44">
                <item android:offset="0" android:color="#66FCD116" />
                <item android:offset="0.6" android:color="#14FCD116" />
                <item android:offset="1" android:color="#00FCD116" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
