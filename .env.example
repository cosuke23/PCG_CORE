# ------------------------------------------------------------------
# PCG_CORE (MEPCOM HRMIS) - copy to .env and fill in. NEVER commit .env
# ------------------------------------------------------------------
APP_NAME="PCG_CORE"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
# Must be false on any machine reachable by other people (incl. Tailscale).
APP_DEBUG=false
# Local example: http://localhost:8000  |  Tailscale: https://<pc>.<tailnet>.ts.net
APP_URL=http://localhost:8000

LOG_CHANNEL=daily
LOG_LEVEL=info

# Existing pcg_core database (MySQL / MariaDB). Use a dedicated account with
# SELECT/INSERT/UPDATE/DELETE on pcg_core only - not root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pcg_core
DB_USERNAME=pcg_app
DB_PASSWORD=

# Sessions (file driver keeps the current behaviour)
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to true when the site is served over HTTPS (e.g. Tailscale Serve).
SESSION_SECURE_COOKIE=false

# Tailscale Serve proxies from 127.0.0.1; trust it so HTTPS links and
# secure cookies work. Leave empty when not behind a proxy.
TRUSTED_PROXIES=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Super-admin login for /admin/login
# Hash: php artisan pcg:hash-password   (keep the single quotes)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=''

# Upload folders. Defaults: <project>/public and <project>/public/selfies.
# Production (cPanel) used:
#   PCG_UPLOAD_ROOT=/home/<account>/public_html/pcg-mepcom.com/public
#   PCG_SELFIE_DIR=/home/<account>/public_html/pcg-mepcom.com/selfies
#   PCG_UPLOAD_URL=https://pcg-mepcom.com/public
PCG_UPLOAD_ROOT=
PCG_SELFIE_DIR=
# Base URL for uploaded files. Empty = APP_URL. Production: https://pcg-mepcom.com/public
PCG_UPLOAD_URL=

MAIL_MAILER=log
