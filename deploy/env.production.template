# MEPCOM HRMIS production settings. Generated on the server by
# server-setup.sh; secrets are filled in there and never leave the server.
APP_NAME="MEPCOM HRMIS"
APP_ENV=production
APP_KEY=@APP_KEY@
APP_DEBUG=false
APP_URL=@APP_URL@

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_SOCKET=/var/lib/mysql/mysql.sock
DB_PORT=3306
DB_DATABASE=@DB_NAME@
DB_USERNAME=@DB_USER@
DB_PASSWORD=@DB_PASSWORD@

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=127.0.0.1
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Private storage, outside the web root (copy the PC's upload folders here).
PCG_UPLOAD_ROOT=@BASE@/shared/uploads
PCG_SELFIE_DIR=@BASE@/shared/uploads/selfies
PCG_DOCUMENT_ROOT=@BASE@/shared/storage/app/private/personnel-documents
PCG_DOCUMENT_MAX_KB=10240

# Uploaded-file encryption (AES-256-GCM, docs/FILE_ENCRYPTION.md). The key ring
# is created on the first release (pcg:file-keys init); keep it out of the
# upload folders and out of the backups. Back it up offline separately.
PCG_FILE_KEYS_PATH=@BASE@/shared/keys/file-keys.json
PCG_FILE_KEYS_MODE=0640

# Admin sign-in: email codes need working mail. Fill in, then on the server:
#   cd @BASE@/current && php artisan config:cache
PCG_ADMIN_2FA=email
# Roles that sign in with the password only (no code); never super_admin. Empty = all use the code.
PCG_ADMIN_PASSWORD_ONLY_ROLES=reenlistment_admin
PCG_ADMIN_EMAIL_CODE_MINUTES=10
# Admin sign-in codes are emailed: fill these in before the first sign-in
# (the 'log' mailer never delivers, and would put codes in the log).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="MEPCOM HRMIS"

# Only until the first admin account exists (php artisan pcg:create-admin).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=''
