# Environment / secrets
.env
.env.*
!.env.example
*.sql
!/database/audit/*.sql
*.sql.gz
/backups/

# Dependencies and build output
/vendor/
/node_modules/
/public/build
/public/hot
/public/storage
/.phpunit.cache
.phpunit.result.cache

# Laravel runtime files
/storage/*.key
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitignore

# Private personnel information - NEVER upload
/public/201_files/
/public/documents_toupload/
/public/disciplinary_actions/
/public/selfies/
/public/profile_photos/
/public/[[]cg_photos/
/selfies/

# Large media and archives
/public/videos/
/public/backgrounds/*.mp4
/public/backgrounds/*.zip
/public/backgrounds/*.docx
/public/backgrounds/*SOI*.html
/public/backgrounds/NEW-FORMAT-SOI*.html

# Large face recognition model files
/public/face-api-models/uncompressed/
/public/face-api-models/proto/*.pbtxt

# Temporary files and logs
*.log
error_log
.DS_Store
Thumbs.db
desktop.ini
